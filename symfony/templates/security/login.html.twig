{% extends 'base.html.twig' %}

{% block title %}Coin Tracker{% endblock %}

{% block body %}
<div class="text-center text-6xl text-blue-300 font-bold mt-40 text-shadow-sm text-shadow-black">Crypto Tracker</div>
<div class="container bg-slate-300 mx-auto max-w-md p-8 rounded-lg shadow-md mt-10  outline-2 outline-blue-500">
    <form class="flex flex-col" method="post">
        {% if error %}
            <div class="text-center text-red-600 font-bold">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <h1 class="text-center mb-4 text-2xl font-bold">Please sign in</h1>
        
        <label for="inputEmail">Email</label>
        <input class="bg-amber-50 border border-gray-300 p-2 rounded" type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>

        <label for="inputPassword">Password</label>
        <input class="bg-amber-50 border border-gray-300 p-2 rounded" type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>

        {# CSRF protection token matching security.yaml entry #}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 mt-10 rounded" type="submit">
            Sign in
        </button>
    </form>
</div>
{% endblock %}
