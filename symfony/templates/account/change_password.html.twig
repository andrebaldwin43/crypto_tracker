{% extends 'base.html.twig' %}
{% form_theme changePasswordForm 'form/tailwind_custom_theme.html.twig' %}
{% block title %}Change Password{% endblock %}

{% block body %}
    <div class="container bg-slate-300 mx-auto max-w-md p-8 rounded-lg shadow-md mt-10 outline-2 outline-blue-500">   
        <h1 class="text-2xl text-blue-500 text-center font-bold mb-10 mt-2">Change Account Details</h1>
        {{ form_start(changePasswordForm) }}
        {{ form_errors(changePasswordForm) }}
        <div class="text-center">
            {{ form_row(changePasswordForm.email) }}
            {{ form_row(changePasswordForm.password.first, {'label':'New Password'}) }}
            {{ form_row(changePasswordForm.password.second) }}
            {{ form_row(changePasswordForm.submit, {'label': 'Submit'}) }}
        </div>
       {{ form_end(changePasswordForm) }}
    </div>
    
    </div>
    
{% endblock %}