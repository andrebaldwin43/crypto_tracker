{% extends 'base.html.twig' %}

{% block title %}Account Details{% endblock %}

{% block body %}

    <div class="container bg-slate-300 mx-auto lg:max-w-lg p-8 rounded-lg shadow-md mt-10 outline-2 outline-blue-500">
        <h2 class="text-2xl font-bold mb-4 text-center">Account Details</h2>
        <p class="mb-4 text-lg"><span class="font-bold">Email:</span> {{ user.email }}</p>
        <p class="mb-4 text-lg"><span class="font-bold">Status:</span> <span class="{{ user.status == 'active' ? 'text-green-600' : 'text-red-600' }}">{{ user.status }}</span></p>
        <div class="justify-center flex mt-6 p-2">
            <a href="{{ path('app_change_password') }}" class="bg-blue-500 text-white px-4 py-2 rounded-lg">Change Password</a>
        </div>
    </div>
{% endblock %}

