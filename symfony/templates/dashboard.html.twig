{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    <h1 class="text-center text-4xl text-blue-400 mt-10 font-bold text-shadow-sm mb-4 text-shadow-black">Overview</h1>
    
    {% if error %}
        <div class="max-w-4xl mx-auto mt-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
            <strong>Error:</strong> {{ error }}
        </div>
    {% endif %}

    <div class="w-full grid grid-cols-1 md:grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="flex flex-col bg-gray-200 rounded-xl shadow-md border border-blue-400">
            <h2 class="text-xl font-bold p-2 text-center">Holdings</h2>
            <div class="p-4">
                {% if cryptoData is empty %}
                    <p class="text-gray-600 text-center">
                        {% if error %}
                            Unable to load holdings due to an error.
                        {% else %}
                            No crypto holdings yet.
                        {% endif %}
                    </p>
                {% else %}
                    {% include '_partials/_cryptoHoldings.html.twig' with {'cryptoData': cryptoData} %}
                {% endif %}
            </div>
        </div>

        <div class="flex flex-col bg-gray-200 rounded-xl shadow-md border border-blue-400" data-chart-container>
            <div class="flex justify-between items-center p-2">
                <h2 class="text-xl font-bold text-center flex-1">Chart</h2>
                <button onclick="resetChart()" class="text-sm bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded transition-colors">
                    Reset
                </button>
            </div>
            <div class="p-4 h-80">
                <canvas id="myChart"></canvas>
            </div>
        </div>
    </div>

    {% block chartdata %}
        <script>
            window.chartData = {
                labels: {{ chart_labels|json_encode|raw }},
                values: {{ chart_values|json_encode|raw }}
            };
        </script>
    {% endblock %}
{% endblock %}