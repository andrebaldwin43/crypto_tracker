{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    <h1 class="text-center text-4xl text-blue-400 mt-10 font-bold text-shadow-sm mb-4 text-shadow-black">Overview</h1>
    
    {% if error %}
        <div class="max-w-4xl mx-auto mt-6 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg">
            <strong>Error:</strong> {{ error }}
        </div>
    {% endif %}

    <div class="w-full grid grid-cols-1 md:grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="min-w-0 flex flex-col bg-gray-200 rounded-xl shadow-md border border-blue-400">
            <h2 class="text-xl font-bold p-2 text-center">Holdings</h2>
            <div class="min-w-0 px-3 pb-4 sm:px-4">
                {% if cryptoData is empty %}
                    <p class="text-gray-600 text-center">
                        {% if error %}
                            Unable to load holdings due to an error.
                        {% else %}
                            No crypto holdings yet.
                        {% endif %}
                    </p>
                {% else %}
                    {% include '_partials/_cryptoHoldingsCard.html.twig' with {'cryptoData': cryptoData} %}
                {% endif %}
            </div>
        </div>

        {% include '_partials/_marketDataCard.html.twig' with {'cryptoData': cryptoData} %}
    </div>

    {% include '_partials/_chartCard.html.twig' %}

{% endblock %}