{% macro compact_number(value, prefix = '') %}
    {%- if value is null -%}
        N/A
    {%- elseif value >= 1000000000000 -%}
        {{ prefix }}{{ (value / 1000000000000)|number_format(3) }}T
    {%- elseif value >= 1000000000 -%}
        {{ prefix }}{{ (value / 1000000000)|number_format(3) }}B
    {%- elseif value >= 1000000 -%}
        {{ prefix }}{{ (value / 1000000)|number_format(3) }}M
    {%- elseif value >= 1000 -%}
        {{ prefix }}{{ (value / 1000)|number_format(3) }}K
    {%- else -%}
        {{ prefix }}{{ value|number_format(2) }}
    {%- endif -%}
{% endmacro %}

<div class="bg-gray-200 rounded-xl shadow-md border border-blue-400">
    <h2 class="text-xl text-center font-bold mt-2">Market Data</h2>
    <div class="px-4" aria-live="polite">
        <p id="market-data-empty" class="text-center text-gray-600">{{ cryptoData is empty ? 'No market data available.' : 'Select a holding to see its market data.' }}</p>
        {% for name, crypto in cryptoData %}
            {% set live = crypto.liveData %}
            {% set quote = live.quote[0]|default({}) %}

            <section id="market-data-{{ loop.index0 }}" data-market-panel="{{ loop.index0 }}" hidden>
                {% if live %}
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-16 p-4">
                        <div>
                            <h4 class="font-semibold mb-6">Market Stats</h4>
                            <dl class="space-y-4">
                                <div class="flex justify-between gap-3">
                                    <dt>Market Rank</dt>
                                    <dd>{{ live.cmc_rank is defined and live.cmc_rank is not null ? '#' ~ live.cmc_rank : 'N/A' }}</dd>
                                </div>
                                <div class="flex justify-between gap-3">
                                    <dt>Market cap</dt>
                                    <dd>{{ _self.compact_number(quote.market_cap is defined ? quote.market_cap : null, '$') }}</dd>
                                </div>
                                <div class="flex justify-between gap-3">
                                    <dt>24h volume</dt>
                                    <dd>{{ _self.compact_number(quote.volume_24h is defined ? quote.volume_24h : null, '$') }}</dd>
                                </div>
                                <div class="flex justify-between gap-3">
                                    <dt>Circulating supply</dt>
                                    <dd>{{ _self.compact_number(live.circulating_supply is defined ? live.circulating_supply : null) }}</dd>
                                </div>
                                <div class="flex justify-between gap-3">
                                    <dt>Max supply</dt>
                                    <dd>{{ _self.compact_number(live.max_supply is defined ? live.max_supply : null) }}</dd>
                                </div>
                            </dl>
                        </div>

                        <div>
                            <h4 class="font-semibold mb-6">Price Performance</h4>
                            <dl class="space-y-4">
                                <div class="flex justify-between gap-3">
                                    <dt>1 hour</dt>
                                    <dd class="{{ quote.percent_change_1h is defined and quote.percent_change_1h is not null and quote.percent_change_1h < 0 ? 'text-red-500' : 'text-green-500' }}">{{ quote.percent_change_1h is defined and quote.percent_change_1h is not null ? quote.percent_change_1h|number_format(2) ~ '%' : 'N/A' }}</dd>
                                </div>
                                <div class="flex justify-between gap-3">
                                    <dt>24 hours</dt>
                                    <dd class="{{ quote.percent_change_24h is defined and quote.percent_change_24h is not null and quote.percent_change_24h < 0 ? 'text-red-500' : 'text-green-500' }}">{{ quote.percent_change_24h is defined and quote.percent_change_24h is not null ? quote.percent_change_24h|number_format(2) ~ '%' : 'N/A' }}</dd>
                                </div>
                                <div class="flex justify-between gap-3">
                                    <dt>7 days</dt>
                                    <dd class="{{ quote.percent_change_7d is defined and quote.percent_change_7d is not null and quote.percent_change_7d < 0 ? 'text-red-500' : 'text-green-500' }}">{{ quote.percent_change_7d is defined and quote.percent_change_7d is not null ? quote.percent_change_7d|number_format(2) ~ '%' : 'N/A' }}</dd>
                                </div>
                            </dl>
                        </div>
                    </div>
                {% else %}
                    <p class="text-gray-600">Market data is unavailable for this holding.</p>
                {% endif %}
            </section>
        {% endfor %}
    </div>
</div>