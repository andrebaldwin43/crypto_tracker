<table class="w-full table-fixed border-none" id="holdings-table">
    <thead class="hidden 2xl:table-header-group">
        <tr>
            <th scope="col" class="text-left p-2">Name</th>
            <th scope="col" class="text-right p-2">Price</th>
            <th scope="col" class="text-right p-2">Balance</th>
            <th scope="col" class="text-right p-2">Value</th>
            <th scope="col" class="text-right p-2">Unrealized P/L</th>
        </tr>
    </thead>
    <tbody>
    {% for name, crypto in cryptoData %}
        <tr class="block cursor-pointer border-b border-gray-300 py-3 last:border-0 hover:bg-gray-100 transition-colors 2xl:table-row 2xl:border-0 2xl:py-0" data-crypto-row="{{ loop.index0 }}" data-coin-id="{{ crypto.liveData.id|default('') }}" data-coin-name="{{ name }}" data-coin-symbol="{{ crypto.cryptoCurrency }}">
            <td class="block px-2 pb-3 text-left 2xl:table-cell 2xl:py-2">
                <div class="flex items-center gap-3">
                    <img
                        src="https://assets.coincap.io/assets/icons/{{ crypto.cryptoCurrency|lower }}@2x.png"
                        alt="{{ name }} logo"
                        class="h-8 w-8 shrink-0"
                        loading="lazy"
                    >
                    <div class="min-w-0">
                        <button type="button" class="font-medium text-left wrap-break-words hover:underline focus-visible:outline-2 focus-visible:outline-blue-600" data-crypto-select="{{ loop.index0 }}" aria-controls="market-data-{{ loop.index0 }}" aria-pressed="false">{{ name }}</button>
                        <div class="text-sm text-gray-500">{{ crypto.cryptoCurrency }}</div>
                    </div>
                </div>
            </td>
            <td class="flex justify-between gap-3 px-2 py-1 text-right 2xl:table-cell 2xl:py-2">
                <span class="text-sm text-gray-600 2xl:hidden">Price</span>
                <span class="break-all">{% if crypto.liveData and crypto.liveData.quote[0] %}${{ crypto.liveData.quote[0].price|number_format(2) }}{% else %}<span class="text-red-500 font-semibold">N/A</span>{% endif %}</span>
            </td>
            <td class="flex justify-between gap-3 px-2 py-1 text-right 2xl:table-cell 2xl:py-2">
                <span class="text-sm text-gray-600 2xl:hidden">Balance</span>
                <span class="break-all">{{ crypto.quantity }}<span class="text-sm">{{ ' ' ~ crypto.cryptoCurrency }}</span></span>
            </td>
            <td class="flex justify-between gap-3 px-2 py-1 text-right 2xl:table-cell 2xl:py-2">
                <span class="text-sm text-gray-600 2xl:hidden">Value</span>
                <span class="break-all">${{ crypto.value|number_format(2) }}</span>
            </td>
            <td class="flex justify-between gap-3 px-2 py-1 text-right 2xl:table-cell 2xl:py-2">
                <span class="text-sm text-gray-600 2xl:hidden">Unrealized P/L</span>
                <span class="break-all {{ (crypto.value - crypto.price) >= 0 ? 'text-green-600' : 'text-red-600' }}">${{ (crypto.value - crypto.price)|number_format(2) }}</span>
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
