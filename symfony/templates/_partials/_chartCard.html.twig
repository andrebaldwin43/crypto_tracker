<div class="w-full mt-6">
    <div class="flex flex-col bg-gray-200 rounded-xl shadow-md border border-blue-400" id="price-chart" data-url="{{ path('app_dashboard_chart') }}">
        <div class="flex flex-wrap justify-between items-center gap-3 p-4">
            <h2 id="chart-title" class="text-xl font-bold">Price history</h2>
            <div class="flex flex-wrap gap-1" role="group" aria-label="Chart time range">
                {% for value, label in {'24h': '24H', '1w': '1W', '1m': '1M', '6m': '6M', '1y': '1Y'} %}
                    <button type="button" data-chart-range="{{ value }}" aria-pressed="{{ value == '24h' ? 'true' : 'false' }}" disabled class="px-3 py-1 rounded text-sm font-medium hover:bg-gray-300 aria-pressed:bg-blue-600 aria-pressed:text-white disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-blue-600">{{ label }}</button>
                {% endfor %}
            </div>
        </div>
        <div class="relative p-4 h-80">
            <p id="chart-status" class="absolute inset-0 flex items-center justify-center px-4 text-center text-gray-600" role="status">Select a holding to see its price history.</p>
            <canvas id="myChart" hidden aria-label="Selected cryptocurrency price history" role="img"></canvas>
        </div>
    </div>
</div>