
{% block body %}
<table class="w-full table-fixed p-4 border-none border-separate border-spacing-y-2.5">
    <thead>
        <tr>
            <th class="text-left p-2">Name</th>
            <th class="text-right">Price</th>
            <th class="text-right">Balance</th>
            <th class="text-right">Value</th>
            <th class="text-right">Unrealized P/L</th>
        </tr>
    </thead>
    <tbody>
    {% for name, crypto in cryptoData %}
        <tr class="cursor-pointer hover:bg-gray-100 transition-colors" data-crypto-row="{{ crypto.cryptoCurrency }}">
            <td class="text-left">
                <div class="flex items-center gap-3">
                    <img
                        src="https://assets.coincap.io/assets/icons/{{ crypto.cryptoCurrency|lower }}@2x.png"
                        alt="{{ name }} logo"
                        class="h-8 w-8 shrink-0"
                        loading="lazy"
                    >
                    <div>
                        <div class="font-medium">{{ name }}</div>
                        <div class="text-sm text-gray-500">{{ crypto.cryptoCurrency }}</div>
                    </div>
                </div>
            </td>
            <td class="text-right">
                {% if crypto.liveData and crypto.liveData.quote[0] %}
                    ${{ crypto.liveData.quote[0].price|number_format(2) }}
                {% else %}
                    <span class="text-red-500 font-semibold">N/A</span>
                {% endif %}
            </td>
            <td class="text-right">{{ crypto.quantity }}<span class="text-sm">{{' ' ~ crypto.cryptoCurrency }}</span></td>
            <td class="text-right">${{ crypto.value|number_format(2) }}</td>
            <td class="{{ (crypto.value - crypto.price) >= 0 ? 'text-green-500' : 'text-red-600' }} text-right">
                ${{ (crypto.value - crypto.price)|number_format(2) }}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}